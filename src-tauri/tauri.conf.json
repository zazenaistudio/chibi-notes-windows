{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chibi Notes",
  "version": "0.4.26",
  "identifier": "com.zazenaistudio.chibinotes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chibi Notes",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/chibi-notes-backend"
    ],
    "resources": {
      "../public/assets/": "assets/",
      "../backend/models/": "models/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "publisher": "Zazen AI Studio",
    "copyright": "Copyright © 2026 Samuel Acosta Fernández — Zazen AI Studio",
    "shortDescription": "Notas-widget kawaii para Windows.",
    "longDescription": "Chibi Notes es un gestor de notas-widget personalizable para Windows con mascotas, fondos, recordatorios, voz y exportación.",
    "licenseFile": "../LICENSE"
  }
}
